{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "corepack enable && corepack prepare pnpm@10.33.0 --activate && pnpm install --frozen-lockfile",
  "buildCommand": "corepack enable && corepack prepare pnpm@10.33.0 --activate && pnpm run build",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "eurorack-panel-designer-oss8.vercel.app" }],
      "destination": "https://www.eurorackpanel.com/:path*",
      "statusCode": 308
    }
  ],
  "rewrites": [
    { "source": "/order/:id", "destination": "/" },
    { "source": "/p/:code/card.png", "destination": "/api/share?code=:code&card=1" },
    { "source": "/p/:code", "destination": "/api/share-page?code=:code" }
  ],
  "headers": [
    {
      "source": "/order/:id",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    },
    {
      "source": "/p/:code",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    }
  ]
}
