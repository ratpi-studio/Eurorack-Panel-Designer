# Ordering on Etsy. The flag turns it on: "true" shows the order button (when the listing URL is
# set too) and lets /api/order store new designs. Off, codes already given still open, so pending
# orders can be printed. Both values are read at build time: redeploy after changing them.
# Prices, widths and filaments live in src/lib/orderCatalog.ts.
VITE_ORDERING_ENABLED=false
VITE_ETSY_LISTING_URL=https://www.etsy.com/listing/REPLACE_WITH_LISTING_ID

# Server-side variables (Vercel Functions only)
# Auto-injected by Vercel when Blob is enabled; api/order.ts stores the ordered designs there.
BLOB_READ_WRITE_TOKEN=

# Sentry (build time). Leave unset locally: Sentry stays disabled.
# Vercel builds derive the environment (vercel-<env>) and release (commit SHA) automatically;
# builds for another host can set SENTRY_ENVIRONMENT.
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
# Source map upload, set by the Sentry Vercel integration
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
