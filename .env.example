# Public client-side variables (must be prefixed with VITE_)
VITE_ETSY_LISTING_URL=https://www.etsy.com/listing/REPLACE_WITH_LISTING_ID
VITE_PRICE_BASE_EUR=8
VITE_PRICE_PER_HP_EUR=1.5

# Server-side variables (Vercel Functions only)
# Auto-injected by Vercel when Blob is enabled
BLOB_READ_WRITE_TOKEN=
# Optional server-side overrides (used by api/order.ts to recompute price)
PRICE_BASE_EUR=8
PRICE_PER_HP_EUR=1.5

# Sentry (build time). Leave unset locally: Sentry stays disabled.
# Vercel builds derive the environment (vercel-<env>) and release (commit SHA) automatically;
# other official deployments set SENTRY_ENVIRONMENT (see .github/workflows/deploy-pages.yml).
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
# Source map upload, set by the Sentry Vercel integration
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
